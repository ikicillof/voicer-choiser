  Partida [label="{Partida|jugadores: list[str]\lnombre_pack: str\lclips: list[Path]\lpuntos: dict[str, list[int]]\l_analisis_originales: dict[Path, Analisis]\l|jugar() → dict[str, int]\ltotales() → dict[str, int]\l_jugar_ronda(numero, clip)\l_turno(jugador, clip, original, segundos) → int\l_analisis_original(clip) → Analisis\l}"];
